# ── Local Docker Compose (docker compose up) ─────────────────────────────

# Host port that nginx (frontend container) is exposed on.
HOST_PORT=8080

# CORS origin allowed by the backend.
# For local docker compose: the nginx host URL is fine.
# In production this is set automatically by infra/setup.sh to the SWA URL.
CORS_ORIGIN=http://localhost:8080

# Clerk publishable key (https://dashboard.clerk.com). Consumed at frontend
# build time — Vite inlines it into the bundle. Missing => the auth buttons
# render a console error on boot.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Where the backend stores leads.jsonl  (default: /data inside the container).
# Useful to override in local dev if you want a specific host path.
# DATA_DIR=/data

# Local PostgreSQL (db service). The backend gets DATABASE_URL built from this
# password; the users table is created by the backend's migrations on startup.
# DB_PORT is the host port, handy for psql / a GUI client.
POSTGRES_PASSWORD=ledens-local
DB_PORT=5432

# Secret used to sign session tokens. Any long random string works locally.
JWT_SECRET=local-dev-only-change-me

# Running the backend outside Docker (npm run dev)? Point it at the db service:
# DATABASE_URL=postgresql://ledens:ledens-local@localhost:5432/ledens


# ── Production / CI — set these in GitHub Secrets, not here ──────────────
#
# AZURE_CREDENTIALS          Service principal JSON for GitHub Actions.
#                            az ad sp create-for-rbac --sdk-auth
#                            (see ledens/infra/setup.sh for the full command)
#
# AZURE_STATIC_WEB_APPS_API_TOKEN  Deployment token for the SWA.
#                            Azure Portal → Static Web Apps → [your app]
#                            → Manage deployment token
#
# DATABASE_URL / JWT_SECRET / OAuth credentials in production live in Key Vault
# and reach the Container App as secret references (infra/setup-database.sh).
#
# These are already configured in .github/workflows/. Do NOT put real values
# in this file or commit them — GitHub Secrets is the right place.
